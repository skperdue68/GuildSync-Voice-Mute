<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="GuildSync-Voice-Mute"
        Arguments=""
        InstallLocation="C:\Program Files\GuildSync\GuildSync Voice Mute">
    </Installer>
    <PackageInformation
        PackageName="GuildSync Voice Mute"
        PackageDisplayName="GuildSync Voice Mute"
        PublisherName="CN=GuildSync"
        PublisherDisplayName="GuildSync"
        Version="1.0.0.0"
        PackageDescription="GuildSync voice-channel mute companion">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="me.perdues.guildsync.voicemute"
                Description="GuildSync voice-channel mute companion"
                DisplayName="GuildSync Voice Mute"
                ExecutableName="GuildSync-Voice-Mute"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GuildSync Voice Mute</DisplayName>
            <PublisherDisplayName>GuildSync</PublisherDisplayName>
            <Description>GuildSync voice-channel mute companion</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="guildsync-voice-mute.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
